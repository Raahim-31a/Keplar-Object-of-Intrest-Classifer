def main():
    parser = argparse.ArgumentParser(description="Kepler KOI classification pipeline")
    parser.add_argument(
        "--stage", choices=["tabular", "lightcurve", "hybrid", "all"], required=True,
        help="Which stage to run.",
    )
    parser.add_argument("--data", default="cumulative_koi.csv",
                        help="Path to the cumulative KOI CSV (tabular/lightcurve stages).")
    parser.add_argument("--lightcurve-out", default="koi_lightcurve_data.npz",
                        help="Where to save preprocessed light curve arrays (lightcurve stage).")
    parser.add_argument("--lightcurve-data", default="koi_lightcurve_data.npz",
                        help="Preprocessed light curve .npz to load (hybrid stage). "
                             "Falls back to synthetic data if not found.")
    parser.add_argument("--limit", type=int, default=None,
                        help="Only process this many KOIs (lightcurve stage) — useful for a quick test run.")
    parser.add_argument("--epochs", type=int, default=50, help="Training epochs (hybrid stage).")
    parser.add_argument("--output-dir", default="koi_pipeline_output",
                         help="Directory to save comparison tables, plots, and the trained model.")
    args = parser.parse_args()

    if args.stage in ("tabular", "all"):
        run_tabular_stage(args.data, args.output_dir)

    if args.stage in ("lightcurve", "all"):
        run_lightcurve_stage(args.data, args.lightcurve_out, limit=args.limit)

    if args.stage in ("hybrid", "all"):
        lc_path = args.lightcurve_out if args.stage == "all" else args.lightcurve_data
        run_hybrid_stage(lc_path, args.output_dir, epochs=args.epochs)


if __name__ == "__main__":
    sys.exit(main())